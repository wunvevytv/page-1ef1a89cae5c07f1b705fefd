ze:19px}\n\n  /* ---------- 套餐：纵向列表逐行展开 ---------- */\n  .plan-list{border-top:2px solid var(--ink)}\n  .plan{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr) minmax(0,200px);gap:28px;padding:30px 0;border-bottom:1px solid var(--line);align-items:start}\n  .plan.is-featured{background:var(--paper-2);padding-left:18px;padding-right:18px;border-left:6px solid var(--brick)}\n  .plan-name h3{margin:0 0 4px;font-size:24px}\n  .plan-name .badge{display:inline-block;font-family:\"Helvetica Neue\",Arial,sans-serif;font-size:11px;letter-spacing:.16em;color:var(--white);background:var(--brick);padding:3px 9px;border-radius:2px;margin-bottom:8px}\n  .plan-name p{margin:0;font-size:14px;color:var(--ink-soft)}\n  .plan-feat{margin:0;padding:0;list-style:none;font-size:15.5px;color:var(--ink-soft)}\n  .plan-feat li{padding-left:20px;position:relative;margin-bottom:7px}\n  .plan-feat li::before{content:\"\";position:absolute;left:0;top:.62em;width:9px;height:2px;background:var(--brick)}\n  .plan-price{text-align:right;font-family:\"Helvetica Neue\",Arial,sans-serif}\n  .plan-price .m{display:block;font-size:26px;font-weight:700;color:var(--ink);letter-spacing:.01em}\n  .plan-price .y{display:block;font-size:13px;color:var(--ink-soft);margin-top:6px}\n  .plan-price .c{display:block;font-size:12px;color:var(--brick);margin-top:10px;letter-spacing:.06em}\n\n  .compare-note{margin-top:26px;font-size:14.5px;color:var(--ink-soft);border-top:1px dashed var(--line);padding-top:16px}\n\n  /* ---------- 客户端说明 ---------- */\n  .client-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n  .client-grid .stripe-card{margin-bottom:0}\n  .client-grid h3{font-size:18px}\n  .client-grid .meta{font-family:\"Helvetica Neue\",Arial,sans-serif;font-size:12px;letter-spacing:.14em;color:var(--brick);margin:0 0 6px}\n\n  /* ---------- FAQ：编号列表 ---------- */\n  .faq-list{counter-reset:faq;margin:0;padding:0;list-style:none;border-top:2px solid var(--ink)}\n  .faq-list > li{counter-increment:faq;display:grid;grid-template-columns:58px minmax(0,1fr);gap:22px;padding:26px 0;border-bottom:1px solid var(--line)}\n  .faq-list > li::before{content:counter(faq,decimal-leading-zero);font-family:\"Helvetica Neue\",Arial,sans-serif;font-size:15px;font-weight:700;color:var(--brick);letter-spacing:.06em;padding-top:3px}\n  .faq-list h3{margin:0 0 8px;font-size:18px}\n  .faq-list p{margin:0;font-size:15.5px;color:var(--ink-soft);max-width:72ch}\n\n  /* ---------- 页脚 ---------- */\n  footer{border-top:1px solid var(--line);background:var(--paper-2);padding:46px 0 54px;font-size:14px;color:var(--ink-soft)}\n  footer .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:28px}\n  footer strong{color:var(--ink);display:block;margin-bottom:8px;font-size:16px}\n  footer p{margin:0 0 8px}\n\n  /* ---------- 底部固定导航 ---------- */\n  .dock{position:fixed;left:0;right:0;bottom:0;background:rgba(36,31,27,.96);border-top:1px solid rgba(255,255,255,.14);z-index:40}\n  .dock ul{width:min(1080px,92vw);margin:0 auto;padding:0;list-style:none;display:flex;justify-content:space-between;gap:10px;overflow-x:auto}\n  .dock li{flex:1 1 auto}\n  .dock a{display:block;text-align:center;padding:15px 8px;color:#f0e6d8;font-size:14px;letter-spacing:.06em;white-space:nowrap;font-family:\"Helvetica Neue\",Arial,sans-serif}\n  .dock a:hover{color:#fff;text-decoration:none;background:rgba(255,255,255,.08)}\n\n  /* ---------- 响应式 ---------- */\n  @media (max-width:860px){.band-2 .wrap{grid-template-columns:1fr;gap:0;}\n    .fact{border-left:none;border-top:1px solid var(--line);padding:16px 0;}\n    .fact:first-child{border-top:none;padding-top:0;}\n    .band-4 .wrap{grid-template-columns:1fr;gap:26px;}\n    .sec-head{grid-template-columns:1fr;gap:14px;}\n    .plan{grid-template-columns:1fr;gap:14px;}\n    .plan-price{text-align:left;}\n    .plan.is-featured{padding-left:16px;padding-right:16px;}\n    .client-grid{grid-template-columns:1fr;}\n    .faq-list > li{grid-template-columns:38px minmax(0,1fr);gap:14px;}\n    footer .wrap{grid-template-columns:1fr;}}\n  @media (max-width:520px){\n    body{font-size:16px}\n    .band-1 .wrap{padding:44px 0 32px}\n    .steps .stripe-card{grid-template-columns:1fr;gap:8px;padding:22px 18px}\n    .dock a{padding:12px 6px;font-size:12.5px;letter-spacing:0}\n  }\n</style><div class=\"band band-1\">\n  <div class=\"wrap\">\n    <div class=\"brand-line\">\n      <span class=\"brand-mark\">桔子云</span>\n      <p class=\"kicker\">套餐 · 用法 · 疑问</p>\n    </div>\n    <h1>桔子云，把订阅这件事讲得慢一点</h1>\n    <p class=\"lede\">大多数服务页面急着让你付款，这一页想做的相反：先把档位、设备数量、年付怎么算、装在哪、出问题找谁——一条条摊开。<strong>你读完再决定，也不迟。</strong></p>\n  </div>\n</div>\n\n<div class=\"band band-2\">\n  <div class=\"wrap\">\n    <dl class=\"fact\">\n      <dt>档位</dt>\n      <dd><span>三档</span>基础版、旗舰版、团队版，按月或按年。</dd>\n    </dl>\n    <dl class=\"fact\">\n      <dt>设备</dt>\n      <dd><span>3 至 20 台</span>同时在线数量随档位递增。</dd>\n    </dl>\n    <dl class=\"fact\">\n      <dt>年付</dt>\n      <dd><span>约为十个月</span>按年一次付清，价格见下方明细。</dd>\n    </dl>\n  </div>\n</div>\n\n<div class=\"band band-3\">\n  <div class=\"wrap\">\n    <p><b>先说明一件事：</b>下面出现的流量、设备数量与线路描述，都是套餐本身的配置口径，不是速度承诺。实际体验受你所在网络环境影响，这一点我们愿意直说。</p>\n    <span class=\"tag\">SHANGHAI · 2024</span>\n  </div>\n</div>\n\n<div class=\"band band-4\">\n  <div class=\"wrap\">\n    <div>\n      <p class=\"kicker\">从哪里开始</p>\n      <h2>先看你的日常用量，再看价格</h2>\n      <p>一个人用手机和电脑、偶尔看剧，和一家人共享、同时挂着几台设备，是两种完全不同的需求。档位不是越大越好，是刚好够用最好。</p>\n      <p class=\"note\">如果读完还有不确定的地方，页面最下方的常见问题里，我们把被问得最多的几件事单独列了出来。</p>\n    </div>\n    <div>\n      <div class=\"stripe-card\">\n        <h3>轻度：一个档位就够</h3>\n        <p>基础版适合每天用几小时、设备不超过三台的人。它有基础的流媒体解锁与普通线路节点池，日常浏览和使用不成问题。</p>\n      </div>\n      <div class=\"stripe-card alt\">\n        <h3>中度：在意线路</h3>\n        <p>旗舰版在设备数与流量之外，多了全节点原生流媒体解锁与 IPLC 专线游戏加速优化，对延迟敏感的人会更有感觉。</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<main>\n\n  <section id=\"steps\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>从下单到连上，四步</h2>\n        <p>没有复杂流程，但每一步都值得认真看一下，尤其是第二步和第三步。</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"stripe-card\">\n          <div class=\"num\">01</div>\n          <div>\n            <h3>确定档位与周期</h3>\n            <p>对照下方的套餐明细，先选档位，再决定月付还是年付。年付是一次付清，折算下来相当于支付十个月。</p>\n          </div>\n        </div>\n        <div class=\"stripe-card\">\n          <div class=\"num\">02</div>\n          <div>\n            <h3>看清设备数量上限</h3>\n            <p>每个档位都写明同时在线设备数：基础版 3 台、旗舰版 5 台、团队版 20 台。超出的部分无法同时在线，这一点在购买前最好先算清楚。</p>\n          </div>\n        </div>\n        <div class=\"stripe-card\">\n          <div class=\"num\">03</div>\n          <div>\n            <h3>在对应客户端完成配置</h3>\n            <p>配置信息需要填写到你所使用的客户端中。不同系统的操作入口不一样，客户端部分列出了常见环境的说明位置。</p>\n          </div>\n        </div>\n        <div class=\"stripe-card\">\n          <div class=\"num\">04</div>\n          <div>\n            <h3>遇到问题按顺序排查</h3>\n            <p>先确认设备数量是否超限，再检查本地网络，最后才判断是否为线路问题。旗舰版与团队版含优先工单与专属服务，可在该通道提交。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档套餐，逐行说明</h2>\n        <p>价格与权益按档位排列，旗舰版是多数人的中间选择。所有档位均支持按月与按年两种周期。</p>\n      </div>\n\n      <div class=\"plan-list\">\n\n        <article class=\"plan\">\n          <div class=\"plan-name\">\n            <h3>基础版</h3>\n            <p>适合一个人、几台设备、日常使用。</p>\n          </div>\n          <ul class=\"plan-feat\">\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"m\">¥15 / 月</span>\n            <span class=\"y\">按年付 ¥150 / 年</span>\n            <span class=\"c\">约合十个月</span>\n          </div>\n        </article>\n\n        <article class=\"plan is-featured\">\n          <div class=\"plan-name\">\n            <span class=\"badge\">多数人选择</span>\n            <h3>旗舰版</h3>\n            <p>在意线路与延迟，设备稍多的人。</p>\n          </div>\n          <ul class=\"plan-feat\">\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"m\">¥35 / 月</span>\n            <span class=\"y\">按年付 ¥350 / 年</span>\n            <span class=\"c\">约合十个月</span>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-name\">\n            <h3>团队版</h3>\n            <p>多人共用，需要定制路由的场景。</p>\n          </div>\n          <ul class=\"plan-feat\">\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"m\">¥85 / 月</span>\n            <span class=\"y\">按年付 ¥850 / 年</span>\n            <span class=\"c\">约合十个月</span>\n          </div>\n        </article>\n\n      </div>\n\n      <p class=\"compare-note\">三档之间的差别集中在三处：流量额度、同时在线设备数、线路与支持方式。价格随之上浮，年付则统一按十个月折算。购买入口与支付方式请以实际页面提供的渠道为准，此处不提供跳转。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端：装在哪，怎么配</h2>\n        <p>配置信息需要在客户端内手动填写。以下按常见使用环境说明大致位置，具体以你下载到的版本为准。</p>\n      </div>\n      <div class=\"client-grid\">\n        <div class=\"stripe-card\">\n          <p class=\"meta\">桌面 · Windows / macOS</p>\n          <h3>电脑端</h3>\n          <p>桌面客户端通常在首次启动时提供配置导入入口，也可在设置中手动填写服务器信息。填写完成后建议先做一次连通性检查，再开始日常使用。</p>\n        </div>\n        <div class=\"stripe-card\">\n          <p class=\"meta\">移动 · iOS / Android</p>\n          <h3>手机端</h3>\n          <p>移动端的配置一般通过应用内的添加按钮完成，部分系统会要求再次确认授权。切换网络（如从 Wi-Fi 到移动数据）后重新检查一次连接状态会更稳妥。</p>\n        </div>\n        <div class=\"stripe-card alt\">\n          <p class=\"meta\">桌面 · Linux</p>\n          <h3>命令行环境</h3>\n          <p>在图形界面较少的系统上，通常需要按客户端文档手动编辑配置并启动。建议先在终端确认进程已运行，再排查网络层面的问题。</p>\n        </div>\n        <div class=\"stripe-card alt\">\n          <p class=\"meta\">共用 · 多设备</p>\n          <h3>多人使用时</h3>\n          <p>同档位下的设备数量是同时在线上限，而非累计绑定次数。超过上限时会有设备被挤下线，这通常不是线路故障。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>下面这些问题来自购买前后的真实困惑，按被问到的频率编号排列。</p>\n      </div>\n\n      <ol class=\"faq-list\">\n        <li>\n          <div>\n            <h3>年付是不是比月付更划算？</h3>\n            <p>按年付的价格约等于十个月的月付金额，这是三档统一的折算方式。如果你确定会持续使用一年以上，年付更省；如果只是短期需要，月付更灵活，也不必一次付清。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>同时在线设备数量是什么意思？</h3>\n            <p>指同一时刻可以保持连接的最大设备数。基础版 3 台、旗舰版 5 台、团队版 20 台。它约束的是同一时间的连接数量，不是一共能绑定多少台设备。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>每月流量用不完会累积到下个月吗？</h3>\n            <p>套餐中的流量额度按月计算，当月的额度只在当月有效。如果你发现经常剩余很多，说明档位可能选高了，往下调一档往往更合适。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>旗舰版里的 IPLC 专线具体指什么？</h3>\n            <p>它是该档位在游戏加速方向上的线路优化配置，与基础版的普通线路节点池不是同一类描述。具体体验仍与你的本地网络相关，这里不做速度上的承诺。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>遇到问题应该先找谁？</h3>\n            <p>旗舰版含 7x24 优先工单支持，团队版含专属客户经理服务。基础版用户可先按使用步骤中的顺序自查：设备数量、本地网络、配置是否完整。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>团队版的企业定制路由需要额外准备什么？</h3>\n            <p>定制路由涉及你所在团队的实际网络结构，通常需要事先梳理清楚使用人数、设备类型与访问范围。建议先整理这些信息，再与客户经理沟通，效率会高很多。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>这一页上为什么没有购买链接？</h3>\n            <p>这一页只负责把套餐与使用方式说明清楚，不承担交易跳转。正式购买请以官方实际提供的渠道为准，我们不会在此处放置未经确认的地址。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <strong>桔子云</strong>\n      <p>把档位、设备、周期和常见疑问一次写清楚，便于你在下单前自己完成判断。</p>\n      <p>本页为静态说明页面，不含交易流程与下载入口。</p>\n    </div>\n    <div>\n      <strong>页面内容</strong>\n      <p><a href=\"#plans\">三档套餐明细</a> · <a href=\"#steps\">使用四步</a> · <a href=\"#clients\">客户端说明</a> · <a href=\"#faq\">常见问题</a></p>\n      <p>套餐名称、价格与权益如发生调整，以官方最新说明为准。</p>\n    </div>\n  </div>\n</footer>\n\n<nav class=\"dock\" aria-label=\"页面区块导航\">\n  <ul>\n    <li><a href=\"#steps\">使用说明</a></li>\n    <li><a href=\"#plans\">套餐明细</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n  </ul>\n</nav>",
